<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_sync_log_list" model="ir.ui.view">
        <field name="name">approval.sync.log.list</field>
        <field name="model">approval.sync.log</field>
        <field name="arch" type="xml">
            <list string="Approval Sync Logs">
                <field name="create_date"/>
                <field name="direction"/>
                <field name="request_name"/>
                <field name="online_request_id"/>
                <field name="sh_request_id"/>
                <field name="status"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="action_approval_sync_logs" model="ir.actions.act_window">
        <field name="name">Approval Sync Logs</field>
        <field name="res_model">approval.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_approval_sync_root" name="Approval Sync"
              groups="base.group_system" sequence="90"/>
    <menuitem id="menu_approval_sync_logs" name="Synchronization Logs"
              parent="menu_approval_sync_root" action="action_approval_sync_logs"
              groups="base.group_system"/>
</odoo>
