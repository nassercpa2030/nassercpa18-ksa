<odoo>
    <data>

        <record model="ir.ui.view" id="kbi_custom.product_template_form_view_inherit">
            <field name="name">kbi_custom.view.order.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
            
                <xpath expr="//div[@name='options']/span[last()]" position="inside">

                    <span class="d-inline-block">
                        <field name="finance_service_ok"/>
                        <label for="finance_service_ok"/>
                    </span>
                    <span class="d-inline-block">
                        <field name="downpayment_ok"/>
                        <label for="downpayment_ok"/>
                    </span>
                </xpath>
                <xpath expr="//field[@name='seller_ids']" position="after">
    <group col="2">
        <group>
            <field name="vendor"/>
            <field name="concentration"/>
            <field name="package_contents"/>
            <field name="discounts_money"/>
        </group>

        <group>
            <field name="scientific_name"/>
            <field name="shape"/>
            <field name="discount" widget="percentage"/>
            <field name="unit"/>
        </group>
    </group>
</xpath>

